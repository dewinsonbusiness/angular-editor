{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Editor Angular",
  "version": "0.1.0",
  "identifier": "com.sildra.editorangular",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:app",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Editor Angular",
        "width": 1280,
        "height": 800,
        "minWidth": 600,
        "minHeight": 400
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "shortDescription": "Editor de código ultraligero para Angular",
    "resources": {
      "../lsp-servers/node_modules/": "lsp-servers/node_modules/"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Spanish"]
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
